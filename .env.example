# ---------------------------------------------------------------------------
# Variables de entorno. Copia este archivo como .env.local y ajusta los valores.
# En Vercel se configuran en Settings > Environment Variables.
# ---------------------------------------------------------------------------

# OBLIGATORIA. Cadena de conexión de PostgreSQL.
# Neon, Supabase, Vercel Postgres, Railway o cualquier PostgreSQL valen.
# Usa siempre el endpoint "pooled" / "pooler" si tu proveedor lo ofrece.
DATABASE_URL=postgresql://usuario:contrasena@host/base?sslmode=require

# OBLIGATORIA EN PRODUCCIÓN.
# Clave usada para firmar la cookie de sesión del panel de administración.
# Genera una con: openssl rand -base64 32
AUTH_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Credenciales del primer administrador. Solo se usan la primera vez que se
# arranca la aplicación (cuando la base de datos aún no tiene usuarios).
# Después puedes cambiarlas desde el panel: Configuración > Cuenta.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NAME=Administrador

# Opcional: número máximo de conexiones del pool (por instancia). Por defecto 5.
# PG_POOL_MAX=5
