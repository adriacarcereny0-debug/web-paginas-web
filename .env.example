# ---------------------------------------------------------------------------
# Variables de entorno. Copia este archivo como .env.local y ajusta los valores.
# ---------------------------------------------------------------------------

# OBLIGATORIA EN PRODUCCIÓN.
# Clave usada para firmar la cookie de sesión del panel de administración.
# Genera una con: openssl rand -base64 32
AUTH_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Credenciales del primer administrador. Solo se usan la primera vez que se
# arranca la aplicación (cuando la base de datos aún no tiene usuarios).
# Después puedes cambiarlas desde el panel: Configuración > Cuenta.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NAME=Administrador

# Opcional: ubicación de la base de datos SQLite y de los datos.
# Por defecto: ./data/app.db
# DATABASE_PATH=/ruta/absoluta/app.db
# DATA_DIR=/ruta/absoluta/data
